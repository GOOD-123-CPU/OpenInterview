# ==============================================
# OpenInterview 环境变量配置示例
# 复制本文件为 .env 并填入你自己的真实值
#   cp .env.example .env
# 切记：.env 已被 .gitignore 排除，绝不要提交真实密钥！
# ==============================================

# ---- LLM 服务（OpenAI 兼容接口）----
# 支持 GLM / OpenAI / DeepSeek / Moonshot 等 OpenAI 兼容服务
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 使用的模型名称（可选，默认 glm-4-plus）
LLM_MODEL=glm-4-plus

# ---- 对外访问地址（用于生成候选人面试链接）----
# 本地开发填 http://localhost:8000/，生产环境填你的域名
PUBLIC_BASE_URL=http://localhost:8000/

# ---- Flask ----
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
FLASK_DEBUG=1

# ---- Whisper 语音识别 ----
# GPU 可用时使用的模型（large-v3 / medium / small），无 GPU 自动回退 base
WHISPER_MODEL_GPU=large-v3
WHISPER_MODEL_CPU=base

# ---- 定时任务轮询间隔（分钟）----
SCHEDULE_INTERVAL_MINUTES=5

# ---- 管理端鉴权 ----
# 首次部署时用于初始化管理员口令（不设置则自动生成随机口令并打印到启动日志）
# 登录后请立即在管理后台「设置」页修改口令
ADMIN_PASSWORD=

# 会话签名密钥（生产环境务必显式设置一串随机字符；不设置则自动生成并持久化）
SECRET_KEY=

# ---- 日志 ----
# 日志输出格式：json（生产推荐，结构化便于采集）或 console（开发友好）
LOG_FORMAT=json

# ---- Webhook 事件通知（可选）----
# 事件回调地址（如企业微信/钉钉/飞书机器人或自建服务）；留空则不推送
WEBHOOK_URL=
# Webhook 签名密钥（HMAC-SHA256，签名置于 X-Webhook-Signature 请求头；建议设置）
WEBHOOK_SECRET=
